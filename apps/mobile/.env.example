# Copy this file to apps/mobile/.env. Restart Expo after changing it.
# EXPO_PUBLIC_SUPABASE_URL matches NEXT_PUBLIC_SUPABASE_URL in apps/web/.env.local.
# EXPO_PUBLIC_SUPABASE_ANON_KEY matches NEXT_PUBLIC_SUPABASE_ANON_KEY in apps/web/.env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. In dev the app calls http://<the Metro host>:3000 unless this is set.
# Use a LAN address, such as http://192.168.1.20:3000, when the phone cannot reach that host.
EXPO_PUBLIC_API_URL=

# Optional. Sentry DSN for the phone app. Leave blank to turn reporting off.
EXPO_PUBLIC_SENTRY_DSN=
