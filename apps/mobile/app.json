{
  "expo": {
    "name": "ScreenPeak",
    "slug": "screenpeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "screenpeak",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.steventpot.screenpeak",
      "associatedDomains": [
        "applinks:screenpeak.app"
      ]
    },
    "android": {
      "package": "com.steventpot.screenpeak",
      "adaptiveIcon": {
        "backgroundColor": "#101215",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "screenpeak.app",
              "path": "/explore"
            },
            {
              "scheme": "https",
              "host": "screenpeak.app",
              "path": "/games"
            },
            {
              "scheme": "https",
              "host": "screenpeak.app",
              "pathPrefix": "/games/"
            },
            {
              "scheme": "https",
              "host": "screenpeak.app",
              "pathPrefix": "/user/"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101215",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ScreenPeak uses your photos so you can pick a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-sentry-node-env",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "im-a-teapot",
          "project": "screenpeak-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#101215",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "expo-status-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "30f79f23-3603-4d22-a862-083a4a6fceba"
      }
    },
    "owner": "steventpot"
  }
}
