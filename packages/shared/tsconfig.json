{
  // Deliberately no "dom" lib and no React/JSX: anything here must run unchanged
  // in Next.js *and* React Native, so a browser or React API won't typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
