{
  "name": "@screenpeak/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Code imported by BOTH apps. Never import db, postgres, next/*, react, or anything server-only here — it all ships inside the phone app. See build-plan.md.",
  "exports": {
    "./api/*": "./api/*.ts",
    "./constants": "./constants.ts",
    "./dates": "./dates.ts",
    "./feed-copy": "./feed-copy.ts",
    "./ratings-copy": "./ratings-copy.ts",
    "./images": "./images.ts",
    "./library-copy": "./library-copy.ts",
    "./titles": "./titles.ts",
    "./tokens": "./tokens.ts",
    "./rating-copy": "./rating-copy.ts",
    "./redirect": "./redirect.ts",
    "./schemas": "./schemas.ts",
    "./sentry": "./sentry.ts",
    "./testing/*": "./testing/*.ts",
    "./types": "./types/index.ts",
    "./types/*": "./types/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
